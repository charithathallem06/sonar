@Library('sonar') _
pipeline { 
    agent any 
 
    tools { 
        maven 'maven3.9.12' 
        jdk 'java17' 
    } 
 
    stages { 
 
        stage('Checkout') { 
            steps { 
                git branch: 'main', url: 'https://github.com/charithathallem06/sonar.git' 
            } 
        } 
 
        stage('Parallel Jobs') { 
            parallel { 
 
                stage('Build') { 
                    steps { 
                        echo "Running Maven Build..." 
                        sh 'mvn clean package' 
                    } 
                } 
 
                stage('SonarQube Scan') { 
                    steps { 
                        echo "Running SonarQube Scan..." 
                        withSonarQubeEnv('sonar') { 
                            sh """
                            mvn sonar:sonar \
                            -Dsonar.projectKey=sample-java-app \
                            -Dsonar.projectName="Sample Java App"
                             """
                        } 
                    } 
                } 
            } 
        } 
 
        stage('Post-Build') { 
            steps { 
                echo "Build + Sonar Scan completed successfully." 
            } 
        } 
    } 
}
